# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dipsan-academy

# Any long random string
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Optional — if left blank, image uploads fall back to local disk storage
# under server/uploads (fine for local dev, not durable on most hosts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
