# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dipsan-academy

# Any long random string
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=5000
CLIENT_ORIGIN=http://localhost:5173,https://dipsan-academy-platform.vercel.app

# Optional but recommended for CDN delivery.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# --- Messaging ---
# OTP + notifications = SMS (Fast2SMS — free trial credits available)
# Exam results = email (SMTP / Gmail app password)
# When FAST2SMS_API_KEY is unset, OTP_DEV_MODE is effectively on (OTP shown in UI).

# SMS via Fast2SMS (https://www.fast2sms.com → Dev API → API Key)
# OTP uses the OTP route (route=otp). Notifications use Quick SMS (route=q).
# In Fast2SMS → Security, leave IP whitelist OFF (Render IPs change).
# Wallet must have credits (OTP SMS is not free after trial).
FAST2SMS_API_KEY=
FAST2SMS_OTP_ROUTE=otp
# Optional: Quick SMS for in-app notification copies
FAST2SMS_ROUTE=q

# Email for exam results only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Dipsan Academy <your@gmail.com>"

# true = always show OTP in API response (local testing only)
OTP_DEV_MODE=false
