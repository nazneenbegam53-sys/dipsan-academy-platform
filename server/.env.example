# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dipsan-academy

# Any long random string
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=5000
CLIENT_ORIGIN=http://localhost:5173,https://dipsan-academy-platform.vercel.app

# Optional but recommended for CDN delivery.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — student full-access subscription (₹2000 INR)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# --- OTP + notifications (email + WhatsApp) ---
# When SMTP / WhatsApp are unset, OTP_DEV_MODE is effectively on and OTPs are
# logged + returned in API responses for testing.

# Email (Gmail app password, SendGrid, Resend SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Dipsan Academy <your@gmail.com>"

# WhatsApp via Twilio (recommended for sandbox / production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OR WhatsApp via Meta Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Force showing OTP in API even when providers are configured (local only)
OTP_DEV_MODE=false
