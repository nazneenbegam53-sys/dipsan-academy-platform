# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dipsan-academy

# Any long random string
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Optional but recommended for CDN delivery.
# If unset, images are stored in MongoDB GridFS (durable across Render restarts).
# Do NOT rely on local disk — files under server/uploads vanish on redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — student full-access subscription (₹2000 INR)
# Create keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Optional: webhook secret for payment.captured events
RAZORPAY_WEBHOOK_SECRET=
