# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dipsan-academy

# Any long random string
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=5000
CLIENT_ORIGIN=http://localhost:5173,https://dipsan-academy-platform.vercel.app

# Optional but recommended for CDN delivery.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# --- OTP ---
# Login codes are generated and verified in this API (MongoDB), then shown on
# the website/app. Phone networks will not accept SMS from our server without
# a paid SMS gateway. Default is in-app OTP (no Fast2SMS).
OTP_DELIVERY=in_app
# Optional: OTP_DELIVERY=sms uses Fast2SMS (requires DLT/OTP wallet).
FAST2SMS_API_KEY=

# Email for exam results only (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Dipsan Academy <your@gmail.com>"
